# Environment Variables
# Copy this file to .env and fill in the values

# Database (PostgreSQL recommended for production)
DATABASE_URL="file:./dev.db"

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-here"

# Google Auth Provider
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Guest cookie signing (REQUIRED in production)
# Secreto para firmar la cookie de invitado. Generar con: openssl rand -base64 48
GUEST_COOKIE_SECRET="change-me"
# Transición de la cookie vieja sin firmar (matete-guest-id): se acepta solo para
# invitados hasta esta fecha (ISO). Setear al día del deploy + 30 días.
# Sin esta variable, la cookie vieja se rechaza siempre.
GUEST_LEGACY_COOKIE_UNTIL="2026-12-31"

# Optional: Deployment Specifics (Hostinger)
# NODE_ENV=production
