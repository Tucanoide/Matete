# Variables para tests de integración y validación local (copiar a .env.test).
# DATABASE_URL y TEST_DATABASE_URL DEBEN apuntar a una base cuyo nombre termine en _test:
# el setup de integración aborta si no es así.
DATABASE_URL="postgresql://localhost:5432/matete_test"
TEST_DATABASE_URL="postgresql://localhost:5432/matete_test"
GUEST_COOKIE_SECRET="generar-con-openssl-rand-base64-48"
GUEST_LEGACY_COOKIE_UNTIL="2099-12-31"
NEXTAUTH_SECRET="test"
NEXTAUTH_URL="http://localhost:3000"
# Base shadow descartable para prisma migrate diff (nunca producción)
SHADOW_DATABASE_URL="postgresql://localhost:5432/matete_shadow"

# Moderación de comentarios (002-social): emails de Google separados por coma
ADMIN_EMAILS=""
