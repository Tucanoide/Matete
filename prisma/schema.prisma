generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String     @id @default(cuid())
  name          String?
  username      String?    @unique
  email         String?    @unique
  emailVerified DateTime?
  image         String?
  points        Int        @default(0)
  neuronas      Int        @default(50)
  levelId       Int        @default(1)
  totalTime     Float      @default(0)
  accounts      Account[]
  progress      Progress[]
  sessions      Session[]
  comments          Comment[]
  commentReports    CommentReport[]
  following         Follow[]           @relation("follower")
  followers         Follow[]           @relation("followee")
  challenges        Challenge[]
  challengeAttempts ChallengeAttempt[]
}

model Level {
  id           Int     @id
  name         String
  description  String?
  costJump     Int     @default(15)
  costLetter   Int     @default(1)
  costHelp     Int     @default(1)
  messageStart String?
  messageEnd   String?
  words        Word[]
}

model Word {
  id             Int        @id
  word           String
  description    String
  difficulty     String?
  type           String?
  levelId        Int
  help01         String?
  help02         String?
  help03         String?
  dictionary     String?
  dictionaryWord String?
  premium        String     @default("N")
  progress       Progress[]
  comments       Comment[]
  challenges     Challenge[]
  level          Level      @relation(fields: [levelId], references: [id])
}

model Progress {
  id              String    @id @default(cuid())
  userId          String
  wordId          Int
  guessed         Boolean   @default(false)
  skipped         Boolean   @default(false)
  revealedIndices Int[]     @default([])
  startTime       DateTime  @default(now())
  endTime         DateTime?
  timeTaken       Float?
  user            User      @relation(fields: [userId], references: [id])
  word            Word      @relation(fields: [wordId], references: [id])

  @@unique([userId, wordId])
}

model Setting {
  id    String @id
  value String
}

model GameMessage {
  id      String @id @default(cuid())
  content String
  type    String // 'success' or 'fail'
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- 002-social ---------------------------------------------------------------

model Comment {
  id          String          @id @default(cuid())
  wordId      Int
  authorId    String
  body        String
  status      String          @default("visible") // visible | hidden_reports | hidden_admin | deleted
  reportCount Int             @default(0)
  createdAt   DateTime        @default(now())
  word        Word            @relation(fields: [wordId], references: [id])
  author      User            @relation(fields: [authorId], references: [id], onDelete: Cascade)
  reports     CommentReport[]

  @@index([wordId, status, createdAt])
  @@index([authorId, createdAt])
  @@index([status])
}

model CommentReport {
  commentId  String
  reporterId String
  createdAt  DateTime @default(now())
  comment    Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  reporter   User     @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@id([commentId, reporterId])
}

model Follow {
  followerId String
  followeeId String
  createdAt  DateTime @default(now())
  follower   User     @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  followee   User     @relation("followee", fields: [followeeId], references: [id], onDelete: Cascade)

  @@id([followerId, followeeId])
  @@index([followeeId])
}

model Challenge {
  id           String             @id @default(cuid())
  code         String             @unique
  creatorId    String
  wordId       Int
  creatorTime  Float
  creatorHints Int
  createdAt    DateTime           @default(now())
  creator      User               @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  word         Word               @relation(fields: [wordId], references: [id])
  attempts     ChallengeAttempt[]

  @@unique([creatorId, wordId])
  @@index([creatorId, createdAt])
}

model ChallengeAttempt {
  id          String    @id @default(cuid())
  challengeId String
  userId      String
  startTime   DateTime  @default(now())
  endTime     DateTime?
  timeTaken   Float?
  solved      Boolean   @default(false)
  gaveUp      Boolean   @default(false)
  knewWord    Boolean   @default(false)
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([challengeId, userId])
  @@index([userId, startTime])
}
